<!-- 顶部栏 -->
 <view class="waveWrapper waveAnimation" style="height:{{navtop+navheigh*1.5}}px;">
	<view class="waveWrapperInner bgTop" >
		<view class="wave waveTop" style="background-image: url({{navimage}});background-size: 540rpx {{navheigh}}px;"></view>
	</view>
	<view class="waveWrapperInner bgMiddle">
		<view class="wave waveMiddle" style="background-image: url({{navimage}});  background-size: 1080rpx {{navheigh*0.8}}px;"></view>
	</view>
	<view class="waveWrapperInner bgBottom;">
		<view class="wave waveBottom" style="background-image: url({{navimage}});  background-size: 540rpx {{navheigh*0.6}}px;"></view>
	</view>

  <view  >
    <!-- <image style=" position:absolute; top:{{navtop+navheigh*0.2}}px; left:{{navheigh*0.4}}px; height:{{navheigh*0.6}}px; width:{{navheigh*0.4}}px " bindtap="backPage" src="/icon/back.png"></image> -->
    <text  style=" position:absolute; top:{{navtop}}px; left:{{navheigh*1.2}}px; height:{{navheigh}}px;line-height:{{navheigh}}px;  font-size: {{navheigh*0.6}}px;">蓝牙连接</text> 
  </view>
</view>



<view class='page-body'>
  <view class='log'>
    <!-- <view>展示log日志(可滑动查看)：</view> -->
    <view>
      <scroll-view scroll-y="true" class='text-box scroll-list'>
        <text>{{textLog}}</text>
      </scroll-view>
    </view>
  </view>
  <view class='scan-view'>
    <button class="btn" bindtap="startClear">清空信息</button>
    <button class="btn" bindtap="startScan">扫描蓝牙</button>
  </view>

  <!-- <view class="devices_summary">已发现 {{devices.length}} 个蓝牙设备：</view> -->
  <scroll-view class="device_list" scroll-y scroll-with-animation>
    <view wx:for="{{devices}}" wx:key="index" data-device-id="{{item.deviceId}}" data-name="{{item.name || item.localName}}" bindtap="createBLEConnection" class="device_item" hover-class="device_item_hover">
      
      <view class="ble-box">
        <view class="left">
          <view style="font-size: 16px; color: #333;">{{item.name}}</view>
          <view style="font-size: 10px">信号强度: {{item.RSSI}}dBm ({{utils.max(0, item.RSSI + 100)}}%)</view>
          <view style="font-size: 10px">UUID: {{item.deviceId}}</view>
          <view style="font-size: 10px">Service数量: {{utils.len(item.advertisServiceUUIDs)}}</view>
        </view>
        <!-- 如果连接成功设备ID等于点击ID设备 则-->
        <view class="right" wx:if="{{item.deviceId==bleConnectedId}}">  <!--if 条件渲染-->
          <image src='../../../icon/btb.png'></image>
        </view>
        <view class="right" wx:else>  <!-- else 条件渲染-->
          <image src='../../../icon/bta.png'></image>
        </view>
       
      </view>
      

    </view>
  </scroll-view>

  <image class='about-img' src='../../../icon/about.png' bindtap='aboutClick'></image>
</view>