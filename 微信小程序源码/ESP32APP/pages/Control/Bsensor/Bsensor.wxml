<!--pages/Control/Bsensor/Bsensor.wxml-->

<!-- 顶部栏 -->
 <view class="waveWrapper waveAnimation" style="height:{{navtop+navheigh*1.5}}px;">
	<view class="waveWrapperInner bgTop" >
		<view class="wave waveTop" style="background-image: url({{navimage}});background-size: 540rpx {{navheigh}}px;"></view>
	</view>
	<view class="waveWrapperInner bgMiddle">
		<view class="wave waveMiddle" style="background-image: url({{navimage}});  background-size: 1080rpx {{navheigh*0.8}}px;"></view>
	</view>
	<view class="waveWrapperInner bgBottom;">
		<view class="wave waveBottom" style="background-image: url({{navimage}});  background-size: 540rpx {{navheigh*0.6}}px;"></view>
	</view>

  <view  bindtap="backPage">
    <image style=" position:absolute; top:{{navtop+navheigh*0.2}}px; left:{{navheigh*0.4}}px; height:{{navheigh*0.6}}px; width:{{navheigh*0.4}}px "  src="/icon/back.png"></image>
    <text  style=" position:absolute; top:{{navtop}}px; left:{{navheigh*1.2}}px; height:{{navheigh}}px;line-height:{{navheigh}}px;  font-size: {{navheigh*0.6}}px;">传感数据</text> 
  </view>
</view>


<!-- 容器上 -->
<scroll-view
    scroll-y="true"
    style="height: {{(screenHeight-navtop-navheigh*1.5)}}px;"
    
 >
<!-- style="height: {{screenHeight-navtop-navheigh*1.5}}px;" -->
  
  <!-- 内部容器 -->
  <scroll-view
    scroll-y="true"
    style="height: {{(screenHeight-navtop-navheigh*1.5)/2}}px;"
   >
  
    <!-- 检测器 -->
    <view class="detector_item" wx:for="{{sensorData}}" wx:key="index">
      <view class="detector_txt1" bindtap="btnChangeName" data-type="sensor" data-name="{{item.sensorName}}" data-sensorid="{{item.sensorId}}"  id="{{index}}">{{item.sensorName}}</view>
      
      <view  wx:if="{{item.sensorValue <400}}">
        <image src="../../../icon/air1.png"></image>
      </view >
      <view wx:elif="{{item.sensorValue <1000}}">
        <image src="../../../icon/air2.png"></image>
      </view>
      <view wx:else>
        <image src="../../../icon/air3.png"></image>
      </view>
      
      <view class="detector_txt2">{{item.sensorValue}} PPM</view>
    </view>

    <!-- 烟雾/可燃气体
    <view class="detector_item" wx:for="{{mqData}}" wx:key="index">
      <view class="detector_txt1">{{item.mqName}}</view>

      <image src="../../../icon/air1.png"></image>

      <view class="detector_txt2">{{item.mqValue}} PPM</view>
    </view> -->

  </scroll-view>

    <!-- 温度湿度 -->
    <view class="HT_item" wx:for="{{htData}}" wx:key="index">
      <view class="htx" bindtap="btnChangeName" data-type="ht" data-name="{{item.htName}}" data-sensorid="{{item.htId}}"  id="{{index}}">{{item.htName}}</view>
      <view class="HumdTemp">

        <view class="Humd">
          <view class="Humd_ico">
            <image src="../../../icon/humd.png" class='humd-logo'></image>
          </view>
          <view class="Humd_txt">
            <view>湿度</view>
            <view>{{item.humidityValue}} %</view>
          </view>
        </view>

        <view class="Temp">
          <view class="Temp_ico">
            <image src="../../../icon/temp.png" class='temp-logo'></image>
          </view>
          <view class="Temp_txt">
            <view>温度</view>
            <view>{{item.temperatureValue}} C</view>
          </view>
        </view>
      </view>
    </view>

</scroll-view>
<!-- 容器上 -->





<!-- 档板 其他地方不能点击--> 
<view class="model" catchtouchmove='preventTouchMove' wx:if='{{showModal}}'></view>
<!-- 盒子 -->
<view class="modalDlg"  wx:if='{{showModal}}'>
  <!-- <view class="title"> 
  </view> -->
  <view class="inputBox">
    <text >修改名称:</text>
    <!-- <input bindinput='wish_put' placeholder=' 请输新名称' class='wish_put'>{{touchName}}</input> -->
    <input bindinput='wish_put'  value="{{touchName}}" class='inputvalue'></input>
  </view>


  <view class="btnBox">
    <view class="isbtn"  bindtap='ok'>
      <text>确定</text>
    </view>
    <view class="centerLine"></view>
    <view class="bkbtn"  bindtap='back'>
      <text>返回</text>
    </view>
  </view>

</view>
