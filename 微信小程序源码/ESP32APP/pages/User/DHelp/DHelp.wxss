/*顶部导航栏  fiexd布局 topviewbox占据塌陷位置*/
@keyframes move_wave {
  0% {
    transform: translateX(0) translateZ(0) scaleY(1);
  }
  50% {
    transform: translateX(-25%) translateZ(0) scaleY(1);
  }
  100% {
    transform: translateX(-50%) translateZ(0) scaleY(1);
  }
}

.waveWrapper {
  overflow: hidden;
  position: relative;
  width: 100%;
  background: #73f3be;
}

.waveWrapperInner {
  position: absolute;
  width: 100%;
  overflow: hidden;
  height: 100%;
  bottom: -1rpx;
}

.bgTop {
  opacity: 0.4;   /*透明度*/
}
.bgMiddle {
  opacity: 0.6;
}
/* .bgBottom {
  opacity: 0.8; 
} */

.wave {
  position: absolute;
  left: 0;
  width: 2160rpx;
  height: 100%;
  background-repeat: repeat no-repeat;
  background-position: 0 bottom;
  transform-origin: center bottom;
}

.wave image {
  width: 100%;
  position: absolute;
  bottom: 0;

}

.waveAnimation .waveTop {
  animation: move_wave 13s linear infinite;
}
.waveAnimation .waveMiddle {
  animation: move_wave 18s linear infinite;
}
.waveAnimation .waveBottom {
  animation: move_wave 9s linear infinite;
}








/*内容*/
.left-scl-view {
  width: 200rpx;
  /* 换行 */
  white-space: initial;
  /* 不换行 */
  /* white-space: nowrap； */
}


/* 左边选择项 */


.leftBox{
  display: flex;
  /* border-bottom: 1rpx solid red; */
}

.left-scl-item {
  position: relative;
  width: 100%;
  height: 100rpx;
  text-align: center;
  background-color: #fff; 
  /* border-bottom: 1rpx solid black; */

}
.title-text{
  line-height: 100rpx;
}

/* 左边选择项 颜色 */
.left-scl-cur {
  background-color: #F8F8F8;
}


/* 左边选择项 竖条 */
.left-scl-view .left-scl-cur::after {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 10rpx 0 0 10rpx;
  position: absolute;
  background-color: black;
  top: 0;
  right: 0rpx;
  bottom: 0;
  margin: auto;
}


/* 右边选项 */
.rightBox{
  background-color: #F8F8F8;
} 

.rightBox{
  margin: 10rpx;
}


.line{
  border-bottom:1rpx solid #F8F8F8;
}

.right_scl_item{

font-size: 40rpx;
