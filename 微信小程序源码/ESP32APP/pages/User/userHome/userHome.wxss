/* ----title---- */
.topScreen{
  height: 500rpx;
  width: 100%;
  float: left;
}


.container {
  position: relative;
  width: 100%;
/* 
  background: -webkit-linear-gradient(135deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
  background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab); */

  background: -webkit-linear-gradient(135deg, #c52253, #c427a2, #23a6d5, #23d5ab);
  background: linear-gradient(-45deg, #ce2658, #c427a2, #23a6d5, #23d5ab);
  background-size: 400% 400%;
  -webkit-animation: daylight 25s ease infinite;
          animation: daylight 25s ease infinite;
  overflow: hidden;

}

.planet {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  width: 200rpx;
  height: 200rpx;
  background: -webkit-linear-gradient(top, #fecf4e 1%, #a3465a 50%, #310441 100%);
  background: linear-gradient(to bottom, #fecf4e 1%, #a62a44 50%, #310441 100%);

  border-radius: 50%;
  -webkit-transform: rotate(-15deg) translate(-35%, -55%);
          transform: rotate(-15deg) translate(-35%, -55%);
}

@supports not ((-webkit-clip-path: inset(50% 0 0 0)) or (clip-path: inset(50% 0 0 0))) {
  .ring-before,
  .ring-after,
  .ring-bigger-before,
  .ring-bigger-after {
    display: none;
  }
}
.ring-before,
.ring-after,
.ring-bigger-before,
.ring-bigger-after {
  content: "";
  width:250rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(248, 197, 77, 0.8);
  position: absolute;

  top: 50%;
  left: 50%;
  margin-left: -120rpx;

  -webkit-transform: skew(-54deg);
          transform: skew(-54deg);
}

.ring-bigger-before,
.ring-bigger-after {
  -webkit-transform: skew(-54deg) scale(1.3);
          transform: skew(-54deg) scale(1.3);
  border-color: #d3bc68;
}

.ring-before,
.ring-bigger-before {
  z-index: 3;
  -webkit-clip-path: inset(50% 0 0 0);
          clip-path: inset(50% 0 0 0);
}

.ring-after,
.ring-bigger-after {
  z-index: 1;
  -webkit-clip-path: inset(0 0 50% 0);
          clip-path: inset(0 0 50% 0);
}

.sub-planet {
  position: absolute;
  top: 24%;
  left: 15%;
  z-index: 4;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: -webkit-linear-gradient(135deg, rgb(255, 255, 255) , #f7f58f , rgb(255, 0, 0) 100%);
  background: linear-gradient(-45deg, rgb(255, 255, 255) , #f7f58f , rgb(255, 0, 0) 100%);
  background-size: 400% 400%;
   -webkit-animation: daylight 25s ease infinite;
          animation: daylight 25s ease infinite;
  overflow: hidden;
}

.orbit {
  width: 10rpx;
  height: 10rpx;
  background: white;
  border-radius: 50%;
  position: absolute;
  top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  z-index: 5;                 /*层级*/
}

.orbit-1 {
  -webkit-animation: orbit-1 5s linear infinite;
          animation: orbit-1 5s linear infinite;
}



@keyframes orbit-1 {
  from {
    -webkit-transform: rotate(0deg) translateX(130rpx) rotate(0deg);
            transform: rotate(0deg) translateX(130rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(130rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(130rpx) rotate(-360deg);
  }
}
.orbit-2 {
  -webkit-animation: orbit-2 10s linear infinite;
          animation: orbit-2 10s linear infinite;
}



@keyframes orbit-2 {
  from {
    -webkit-transform: rotate(0deg) translateX(150rpx) rotate(0deg);
            transform: rotate(0deg) translateX(150rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(150rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(150rpx) rotate(-360deg);
  }
}
.orbit-3 {
  -webkit-animation: orbit-3 15s linear infinite;
          animation: orbit-3 15s linear infinite;
}


@keyframes orbit-3 {
  from {
    -webkit-transform: rotate(0deg) translateX(170rpx) rotate(0deg);
            transform: rotate(0deg) translateX(170rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(170rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(170rpx) rotate(-360deg);
  }
}
.orbit-4 {
  -webkit-animation: orbit-4 20s linear infinite;
          animation: orbit-4 20s linear infinite;
}



@keyframes orbit-4 {
  from {
    -webkit-transform: rotate(0deg) translateX(190rpx) rotate(0deg);
            transform: rotate(0deg) translateX(190rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(190rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(190rpx) rotate(-360deg);
  }
}
.orbit-5 {
  -webkit-animation: orbit-5 25s linear infinite;
          animation: orbit-5 25s linear infinite;
}


@keyframes orbit-5 {
  from {
    -webkit-transform: rotate(0deg) translateX(210rpx) rotate(0deg);
            transform: rotate(0deg) translateX(210rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(210rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(210rpx) rotate(-360deg);
  }
}
.orbit-6 {
  -webkit-animation: orbit-6 30s linear infinite;
          animation: orbit-6 30s linear infinite;
}



@keyframes orbit-6 {
  from {
    -webkit-transform: rotate(0deg) translateX(230rpx) rotate(0deg);
            transform: rotate(0deg) translateX(230rpx) rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg) translateX(230rpx) rotate(-360deg);
            transform: rotate(360deg) translateX(230rpx) rotate(-360deg);
  }
}
.cloud {
  background: #f1f1f1;
  width: 100rpx;
  height: 30rpx;
  position: absolute;
  border-radius: 50%;
  bottom: -5rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.1);
}
.cloud:before, .cloud:after {
  content: "";
  background: #f1f1f1;
  border-radius: 50%;
  position: absolute;
}
.cloud:before {
  width: 50rpx;
  height: 50rpx;
  bottom: 2rpx;
  left: 5rpx;
}
.cloud:after {
  width: 40rpx;
  height: 40rpx;
  bottom: 2rpx;
  right: 15rpx;
}

.cloud-group-1,
.cloud-group-2,
.cloud-group-3 {
  position: absolute;
  bottom: 0;
  width: 211rpx;
  height: 100rpx;
  opacity: .2;
}

.cloud-group-1 {
  bottom: -5rpx;
}

.cloud-group-2 {
  -webkit-transform: scale(2);
          transform: scale(2);
  bottom: 20rpx;
  left: -50rpx;
}

.cloud-group-3 {
  -webkit-transform: scale(3);
          transform: scale(3);
  bottom: 100rpx;
  left: -24rpx;
}

.cloud-2 {
  left: 10rpx;
}

.cloud-3 {
  right: 10rpx;
}

.cloud-4 {
  right: 184rpx;
  bottom: 0;
}

.cloud-5 {
  right: 24rpx;
  bottom: 12rpx;
}

.cloud-6 {
  right: -45rpx;
  bottom: 9;
}

.star {
  position: absolute;
  left: 0;
  top: 50rpx;
  width: 1rpx;
  height: 1rpx;
  background-color: white;
  -webkit-animation: shooting 5s linear infinite;
          animation: shooting 5s linear infinite;
}
.star:before {
  content: "";
  position: absolute;
  width: 100rpx;
  height: 1rpx;
  right: 1rpx;
  top: 0;
  background: -webkit-linear-gradient(left, transparent 0%, rgba(255, 255, 255, 0.4) 100%);
  background: linear-gradient(to right, transparent 0%, rgba(255, 255, 255, 0.4) 100%);
}

.star-2 {
  top: 100rpx;
  -webkit-animation: shooting 8s 1s linear infinite;
          animation: shooting 8s 1s linear infinite;
}

.star-3 {
  top: 250rpx;
  -webkit-animation: shooting 3s 2s linear infinite;
          animation: shooting 3s 2s linear infinite;
}


@keyframes daylight {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes shooting {
  from {
    left: -100rpx;
  }
  to {
    left: calc(100% + 100rpx);
  }
}
